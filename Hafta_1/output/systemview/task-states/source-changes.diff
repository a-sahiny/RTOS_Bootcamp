+/* State changes come from kernel hooks, never a polling task. Keeping only
+ * the stop cause also lets Start report tasks which blocked before recording. */
+static void _SetTaskStopCause(U32 TaskID, unsigned Cause) {
+  unsigned n;
+  for (n = 0; n < _NumTasks; n++) {
+    if (_aTasks[n].xHandle == TaskID) {
+      _aTasks[n].StopCause = Cause;
+      break;
+    }
+  }
+}
+
+void SYSVIEW_TaskReady(U32 TaskID) {
+  SEGGER_SYSVIEW_LOCK();
+  _SetTaskStopCause(TaskID, 0u);
+  SEGGER_SYSVIEW_OnTaskStartReady(TaskID);
+  SEGGER_SYSVIEW_UNLOCK();
+}
+
+void SYSVIEW_TaskStopReady(U32 TaskID, unsigned Cause) {
+  SEGGER_SYSVIEW_LOCK();
+  _SetTaskStopCause(TaskID, Cause);
+  SEGGER_SYSVIEW_OnTaskStopReady(TaskID, Cause);
+  SEGGER_SYSVIEW_UNLOCK();
+}
+
+void SYSVIEW_SendTaskStates(void) {
+  unsigned n;
+  U32 CurrentTask = 0u;
+  U32 RunningTask = 0u;
+  SEGGER_SYSVIEW_LOCK();
+  /* Start arrives in the USART6 ISR. Do not call eTaskGetState or traverse
+   * kernel lists here: a task may have been interrupted during a list update.
+   * These two getters only read scheduler state/current TCB in this port. */
+  if (xTaskGetSchedulerState() != taskSCHEDULER_NOT_STARTED) {
+    CurrentTask = (U32)xTaskGetCurrentTaskHandle();
+  }
+  for (n = 0; n < _NumTasks; n++) {
+    if (_aTasks[n].StopCause == 0u) {
+      SEGGER_SYSVIEW_OnTaskStartReady(_aTasks[n].xHandle);
+      if (_aTasks[n].xHandle == CurrentTask) {
+        RunningTask = CurrentTask;
+      }
+    } else {
+      SEGGER_SYSVIEW_OnTaskStopReady(_aTasks[n].xHandle, _aTasks[n].StopCause);
+    }
+  }
+  if (RunningTask != 0u) {
+    SEGGER_SYSVIEW_OnTaskStartExec(RunningTask);
+  } else if (CurrentTask != 0u && CurrentTask == (U32)xTaskGetIdleTaskHandle()) {
+    SEGGER_SYSVIEW_OnIdle();
+  }
+  SEGGER_SYSVIEW_UNLOCK();
+}
